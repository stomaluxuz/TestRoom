# Скопируйте этот файл в .env и заполните.

# Токен бота от @BotFather
BOT_TOKEN=1234567890:AAAA-ваш-токен

# Ваш Telegram ID (узнать: напишите боту /myid или @userinfobot). Несколько — через запятую.
ADMIN_IDS=123456789

# Публичный https-адрес сервера, где открывается Mini App.
# Для теста на своём компьютере — адрес из cloudflared (см. README).
WEBAPP_URL=https://example.trycloudflare.com

# База данных. По умолчанию — файл testbot.db рядом с проектом.
DATABASE_URL=sqlite+aiosqlite:///./testbot.db
# PostgreSQL: DATABASE_URL=postgresql+asyncpg://user:password@localhost/testbot

PORT=8080
HOST=0.0.0.0

# Сколько процессов веб-сервера запустить (только Linux). Ставьте по числу ядер процессора.
WEB_WORKERS=1

# Лимиты бесплатного тарифа
FREE_MAX_TESTS=3
FREE_MAX_STUDENTS=30

# Вход в Mini App из обычного браузера без Telegram: http://localhost:8080/?dev=ID
# Только для проверки на своём компьютере! На сервере всегда 0.
DEV_AUTH=0
